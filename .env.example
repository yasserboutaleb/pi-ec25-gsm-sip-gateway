# pi-ec25-gsm-sip-gateway settings. Copy to .env (chmod 600: it holds passwords), then
#   docker compose up -d
# The Asterisk configuration is generated from these values at every start (gw-config).
# Check the values without starting:  docker compose run --rm gateway gw-config check
# Passwords: no ; \ " or newline.

# ---------------------------------------------------------------- modem
# AT port of the module. With an EC25 the USB interface 2 is the AT port; the by-id link stays
# the same whatever USB port or hub port the modem is plugged into: ls -l /dev/serial/by-id
MODEM_DATA_PORT=/dev/serial/by-id/usb-Android_Android-if02-port0
# Voice: uac = USB audio (EC25 with UAC enabled, docs/HARDWARE.md), serial = PCM over a serial port
MODEM_AUDIO=uac
# uac: ALSA device of the module (cat /proc/asound/cards: the EC25 is the card "Android")
MODEM_ALSA_DEVICE=hw:CARD=Android
# serial: audio port (EC25: USB interface 1)
#MODEM_AUDIO_PORT=/dev/serial/by-id/usb-Android_Android-if01-port0
# Call states: notifications plus AT+CLCC polling every 1000 ms (0 = notifications only)
MODEM_CLCC_POLL=1000

# ---------------------------------------------------------------- SIP softphone on the LAN
# Account for a softphone (Linphone, Zoiper, a desk phone...) that registers with the gateway:
# user name and authentication name in the softphone (letters, digits, _ . + -).
# Empty password = no softphone.
SOFTPHONE_USERNAME=gsm
SOFTPHONE_PASSWORD=
# Network the softphone connects from (the only source accepted, besides the loopback)
SOFTPHONE_NETWORK=192.168.1.0/24

# ---------------------------------------------------------------- SIP server or PBX
# The gateway as a trunk of an Asterisk, FreePBX, 3CX... server.
SERVER_ENABLED=0
# register: the gateway registers with an account (works through NAT)
# ip: trusted peer identified by its address, no password (a VPN of the host, or a trusted LAN;
#     on a shared LAN use register, see docs/SECURITY.md)
SERVER_MODE=register
SERVER_HOST=
SERVER_PORT=5060
SERVER_USERNAME=
SERVER_PASSWORD=
# Extension of the server that receives GSM calls, SMS and USSD replies
SERVER_EXTENSION=
SERVER_CODEC=ulaw
# ip mode: address of the gateway as the server sees it (host part of the From of SMS messages)
SERVER_LOCAL_ADDRESS=

# ---------------------------------------------------------------- behaviour
# Incoming GSM calls ring: auto (server if enabled, else softphone), server, softphone, both
INCOMING_CALLS_TO=auto
# 1 = incoming GSM calls are answered and echoed back (audio test of the GSM side)
GSM_ECHO_TEST=0
# 1 = dial *code# from the SIP side to send a USSD request; the reply comes back as a message
USSD_ENABLED=1
# 1 = text of USSD replies also written in the log, for a local tool (status page, payment menus).
# Off by default: a reply may hold a balance or codes. Local tools send a USSD with:
#   asterisk -rx "channel originate Local/s@ussd-console application QUECTEL_SEND_USSD quectel0,*100#"
USSD_LOG_TEXT=0
# Ringback of outgoing calls: network (the operator's own) or local (generated by the gateway,
# useful when the network sends none, e.g. some VoLTE networks)
RINGBACK=network
# Jitter buffer on the voice from SIP to the modem: adaptive (default), fixed or off. Needed with USB
# audio when the SIP side is reached through a VPN, Wi-Fi or Internet (no voice otherwise, docs/TROUBLESHOOTING.md)
JITTER_BUFFER=adaptive
# Numbers allowed for calls and SMS, as an extended regular expression on the dialled number
# (national format or +international). Empty = any number. Set it so that a stolen softphone password
# cannot reach premium or international numbers. Write [+] for a literal +. Example, French mobiles:
#   DIAL_ALLOW=^(0[67]|[+]33[67])[0-9]{8}$
DIAL_ALLOW=
# Tones (busy, ringback...): two-letter country code
COUNTRY=fr

# ---------------------------------------------------------------- network
# Address and port Asterisk listens on (0.0.0.0 = every address of the host)
SIP_BIND=0.0.0.0
SIP_PORT=5060
RTP_START=10000
RTP_END=10100

# Asterisk console verbosity (0 to 5). Above 0 the log shows full phone numbers and SMS texts.
GSM_VERBOSE=0
